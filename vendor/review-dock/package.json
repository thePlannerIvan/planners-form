{
  "name": "dsh-review-dock",
  "version": "0.2.5",
  "description": "DSH 右侧栏的通用审阅宿主：任何 Skill 交一份 review-surface.json 与自己的审阅页，人就在侧栏里审；页面通过 postMessage 桥读写资产、落反馈，并唤醒 Agent。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARK.md",
    "COMMERCIAL.md",
    "SECURITY.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "review",
    "human-in-the-loop"
  ],
  "author": "阿祖不看 TVC <Lawyif@163.com> (https://demyth.info)",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/thePlannerIvan/dsh-review-dock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thePlannerIvan/dsh-review-dock.git"
  },
  "bugs": {
    "url": "https://github.com/thePlannerIvan/dsh-review-dock/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
